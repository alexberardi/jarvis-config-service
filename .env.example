# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_config
MIGRATIONS_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jarvis_config

# Auth service URL (for JWT validation in Docker: use host.docker.internal)
JARVIS_AUTH_URL=http://host.docker.internal:7701

# Admin token for write operations (POST/PUT/DELETE)
# Generate with: openssl rand -hex 32
JARVIS_CONFIG_ADMIN_TOKEN=__SET_ME__

# Token to call jarvis-auth admin endpoints (for service registration)
JARVIS_AUTH_ADMIN_TOKEN=

# Server settings
PORT=7700
HOST=0.0.0.0

# Health check timeout in seconds
HEALTH_CHECK_TIMEOUT=5.0

# Rewrite localhost probes to reach host machine from inside Docker
DOCKER_HOST_GATEWAY=host.docker.internal

# In-container mount point for the jarvis root (for writing .env files)
# Set automatically by ./jarvis init
#JARVIS_ROOT=/jarvis

# Host path to jarvis root (used by docker-compose for volume mount)
# Set automatically by ./jarvis init
#JARVIS_HOST_ROOT=/home/user/jarvis
